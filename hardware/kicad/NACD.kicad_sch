	)
	(text_box "Fixes\n\nFor future revision GPA7 and GPB7 should not be used as an input and should be exclusively as an ouput.  \n\nFix this in the next board revision.\n\nIf you configure GPA7 as an input and the pin voltage changes while the chip transmits a bit, it can corrupt the I²C SDA signal and cause the bus host to malfunction"
		(exclude_from_sim no)
		(at 432.816 96.5757 0)
		(size 75.184 39.5683)
		(margins 0.9525 0.9525 0.9525 0.9525)
