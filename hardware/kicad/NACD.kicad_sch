	)
	(text_box "FACEPLATE CONNECTOR\nPIN 1: BULB V+\nPIN 2: GND\nPIN 3: Keypad Row 3 → MCP23017 GPB3\nPIN 4: Keypad Row 2 → MCP23017 GPB2\nPIN 5: Keypad Row 1 → MCP23017 GPB1\nPIN 6: Keypad Row 0 → MCP23017 GPB0\nPIN 7: EJECT SWITCH → MCP23017 GPA3\nPIN 8: Keypad Column 1 → MCP23017 GPA2\nPIN 9: Keypad Column 0 → MCP23017 GPA1\nPIN 10: PIN SWITCH → MCP23017 GPA0"
